# Your Shopify store's .myshopify.com domain
SHOPIFY_SHOP_DOMAIN=niaz-arts-2.myshopify.com

# Shopify ADMIN API token (starts with shpat_)
# Get this from: Shopify Admin → Settings → Apps → Develop apps →
#   your app → API credentials → Admin API access token
# ⚠️  This is SECRET — never put this in Flutter or any client app
SHOPIFY_ADMIN_TOKEN=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

# Shopify API version
SHOPIFY_API_VERSION=2024-10
